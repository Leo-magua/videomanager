<?xml version="1.0" encoding="utf-8"?>
<!-- 家用局域网内 PC 无 HTTPS 证书，允许对任意主机的明文 HTTP（元数据 API + 视频流）。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
